rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMaintenance() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email in ['replace-with-maintenance-email@example.invalid'];
    }

    function validFaultReport() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'equipmentName', 'location', 'description', 'priority', 'reporterName',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'equipmentName', 'location', 'description', 'priority', 'reporterName',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.equipmentName is string
        && data.equipmentName.size() > 0
        && data.equipmentName.size() <= 120
        && data.equipmentName.matches('.*\\S.*')
        && data.location is string
        && data.location.size() > 0
        && data.location.size() <= 160
        && data.location.matches('.*\\S.*')
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 2000
        && data.description.matches('.*\\S.*')
        && data.priority in ['LOW', 'MEDIUM', 'HIGH']
        && data.reporterName is string
        && data.reporterName.size() <= 120
        && data.status == 'OPEN'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    match /faultReports/{faultId} {
      allow get, list: if isMaintenance();
      allow create: if signedIn() && validFaultReport();
      allow update: if isMaintenance()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['OPEN', 'IN_PROGRESS', 'RESOLVED']
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}